// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Multi-tenant core: every model except Business carries a `businessId`
// foreign key so rows are always scoped to a single tenant.
// ---------------------------------------------------------------------------

model Business {
  id             String   @id @default(cuid())
  name           String
  phone          String
  whatsappNumber String
  createdAt      DateTime @default(now())
  /// Last time the owner opened the Notifications page. Escalations newer than
  /// this drive the unread bell badge.
  lastNotificationsReadAt DateTime?

  /// AI writing style. One of "formal", "friendly" or "pidgin_friendly";
  /// stored as text so adding a tone is not a migration.
  tone          String  @default("friendly")
  /// Free text such as "Mon-Fri 9am-6pm, Sat 10am-4pm". Shown to the AI and
  /// displayed on the Settings page.
  businessHours String?
  /// Street address, used on invoices/receipts (optional).
  address       String?
  /// Short description of what the business sells, given to the AI as context.
  description       String?
  /// Payment details (bank/transfer instructions) the AI can share to close sales.
  paymentInstructions String? @db.Text

  /// Two-Number Model: the business keeps its own WhatsApp on the owner's
  /// phone; Colly assigns a separate dedicated AI line. `aiLineConnected` is
  /// false until that line is provisioned and live (no Meta/telephony
  /// connection is built yet — this flag only drives the onboarding banner
  /// and the /settings/ai-line status). `phone` holds the requested
  /// AI line number from signup.
  aiLineConnected Boolean @default(false)

  /// NRS (National Revenue Service) e-invoicing compliance. `nrsTaxId` is the
  /// NRS Tax ID (the CAC number); `nrsRegistrationDate` is when it was saved
  /// here. `nrsTier` is reserved for future tiering, `nrsExemptReason` marks
  /// businesses that handed compliance to their accountant, and
  /// `nrsLastDismissedAt` gates the "Get NRS-compliant" banner for 7 days.
  nrsTaxId            String?
  nrsRegistrationDate DateTime?
  nrsTier             String?
  nrsExemptReason     String?
  nrsLastDismissedAt  DateTime?

  /// Billing. `plan` is the tier name for the business's channel:
  /// "free" | "starter" | "business" | "pro" (WhatsApp) or "green" | "blue" |
  /// "black" (Telegram); `planInterval` is "monthly" | "yearly"; `planStatus`
  /// is "inactive" (Free) | "active" | "past_due" | "cancelled" | "expired".
  /// The old trial plan ("trial" / "trialing") is retired: signup no longer
  /// sets it, and every reader treats such a row as Free. The permanent Free
  /// tier grants 50 `planCredits` every month and never expires.
  /// Credits are a SPLIT WALLET (1 credit = ₦1), so a monthly allowance can
  /// never be hoarded:
  /// - `planCredits` is the plan's monthly allowance. Every successful plan
  ///   charge OVERWRITES it with that plan's grant (it is never added to), so
  ///   unused allowance resets at each renewal instead of stacking up.
  /// - `topUpCredits` are credits the business paid for. They are never reset,
  ///   so they keep paying for replies after the monthly allowance is gone.
  /// Each AI reply spends 5 credits on Telegram, Discord or Web Chat and 40 on
  /// WhatsApp, always drawing from `planCredits` first, then `topUpCredits`.
  /// Manual replies are free.
  /// `paystackCustomerCode` / `paystackSubscriptionCode` / `paystackEmailToken`
  /// identify the business in Paystack; `paystackEmailToken` is needed to
  /// pause/resume a Paystack subscription. `billingEmail` receives receipts.
  plan                     String    @default("free")
  planInterval             String    @default("monthly")
  planStatus               String    @default("trialing")
  /// Set when a recurring payment fails; cleared on the next successful charge.
  paymentFailedAt          DateTime?
  planStartedAt            DateTime  @default(now())
  planExpiresAt            DateTime?
  onboardingEndsAt         DateTime?
  planCredits              Int       @default(0)
  topUpCredits             Int       @default(0)
  paystackCustomerCode     String?
  paystackSubscriptionCode String?
  paystackEmailToken       String?
  billingEmail             String?

  /// Legacy trial columns, kept so old rows need no data migration. The trial
  /// is retired: `trialEndsAt` is no longer set at signup, and
  /// `aiMessagesUsed` / `manualMessagesUsed` are lifetime reply counters only.
  /// `onboardingEndsAt` above is the separate onboarding window.
  trialEndsAt        DateTime?
  aiMessagesUsed     Int      @default(0)
  manualMessagesUsed Int      @default(0)

  /// The plan tier the customer picked before signing up (e.g. "green" from
  /// /signup?plan=green). Pre-selects that tier on the plans page; the live
  /// subscription still lives in `plan` above.
  selectedPlan String?

  /// Messaging channel. `channel` is which channel this business runs on:
  /// "TELEGRAM" | "DISCORD". Telegram businesses connect their own bot:
  /// `telegramBotToken` is the bot token from BotFather and `telegramChatId`
  /// is the chat the AI should answer in.
  channel             String  @default("TELEGRAM")
  telegramBotToken    String?
  telegramChatId      String?
  /// Bot handle from the getMe response (without "@"), shown to the owner as
  /// a shareable t.me link once the bot is connected.
  telegramBotUsername String?

  /// Discord integration. `discordBotToken` is the bot token copied from the
  /// Discord developer portal; `discordGuildId` is the server ("guild") the
  /// bot should answer in. Either one can identify the business on an
  /// incoming interaction.
  discordBotToken String?
  discordGuildId  String?

  /// The OWNER'S personal Telegram chat id (from @userinfobot), NOT the
  /// customer chat (`telegramChatId` above). When set, escalation alerts from
  /// `escalate_to_owner` are delivered there via the Colly Admin Bot
  /// (COLLY_TELEGRAM_BOT_TOKEN).
  ownerTelegramChatId String?

  /// Channel connection state, set by the AI Line settings page:
  /// "DISCONNECTED" (default, nothing connected yet) |
  /// "CONNECTED" (Telegram bot or Discord bot verified).
  connectionStatus String  @default("DISCONNECTED")

  /// Automated dunning. `subscriptionStatus` tracks the Paystack subscription
  /// lifecycle: "active" | "past_due" | "canceled". When a subscription charge
  /// fails the webhook marks the business "past_due" and sets
  /// `gracePeriodEndsAt` 3 days out; `requireAiEnabled` stops the AI once that
  /// grace period lapses. A later successful charge (or `invoice.payment_success`)
  /// clears both back to "active" / null.
  subscriptionStatus String    @default("active")
  gracePeriodEndsAt  DateTime?

  /// Message tracking for plan caps. `messagesUsedThisMonth` counts AI replies
  /// sent this billing month. `messagesResetAt` is when the counter resets
  /// (next billing anniversary). `aiEnabled` gates auto-replies when cap is
  /// hit or plan expires â€” can be toggled by owner if they buy credits.
  messagesUsedThisMonth Int      @default(0)
  messagesResetAt       DateTime @default(now())
  aiEnabled             Boolean  @default(true)

  /// Manual message tracking (agent replies) for tiered deductions.
  manualMessagesUsedThisMonth Int @default(0)

  /// Referral tracking. Set at signup when the owner enters a certified
  /// agent's ID ("AG-0001"). Colly pays the agent 15% of every subscription
  /// charge for the first 12 months; `commissionEndsAt` is when that window
  /// closes (the agent earns nothing from this business after it).
  referredByAgentId String?
  commissionEndsAt  DateTime?

  users         User[]
  customers     Customer[]
  products      Product[]
  sales         Sale[]
  conversations Conversation[]
  messages      Message[]
  faqs          Faq[]
  invoices      Invoice[]
  transactions  Transaction[]

  referredByAgent Agent? @relation(fields: [referredByAgentId], references: [id])
}

model Faq {
  id         String   @id @default(cuid())
  businessId String
  question   String
  answer     String
  category   String?
  createdAt  DateTime @default(now())

  /// pgvector embedding of question + answer + category, used for semantic
  /// search. 1024 dimensions from jina-embeddings-v3. Unsupported by
  /// Prisma Client; read/written with raw SQL in lib/embedding-pipeline.ts.
  embedding Unsupported("vector(1024)")?

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
}

model User {
  id         String   @id @default(cuid())
  businessId String
  email      String   @unique
  name       String?
  password   String
  role       String
  createdAt  DateTime @default(now())

  /// Supabase Auth user id (auth.users.id). Kept nullable so the rows that
  /// already exist stay valid; lib/auth.ts links an unclaimed row to an auth
  /// user by email the first time that owner signs in.
  supabaseUserId String? @unique

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
}

model Customer {
  id              String    @id @default(cuid())
  businessId      String
  name            String
  phone           String
  tags            String[]  @default([])
  notes           String?   @db.Text
  totalSpent      Float     @default(0)
  /// CRM pipeline stage: "INQUIRY" | "NEGOTIATING" | "PAID" | "DELIVERED".
  dealStatus      String    @default("INQUIRY")
  lastContactedAt DateTime?
  createdAt       DateTime  @default(now())

  business      Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  sales         Sale[]
  conversations Conversation[]
  invoices      Invoice[]

  @@unique([businessId, phone])
  @@index([businessId])
}

model Product {
  id          String   @id @default(cuid())
  businessId  String
  name        String
  description String?
  /// Extra customer-facing details (specs, condition, sizes) the owner adds for
  /// the AI to draw on. Free text; null means none provided.
  details     String?
  price       Decimal  @db.Decimal(10, 2)
  /// The lowest price the AI may offer when negotiating. null means the AI
  /// never goes below the list price.
  floorPrice  Decimal? @db.Decimal(10, 2)
  /// When false the AI refuses every offer for this product.
  negotiable  Boolean  @default(true)
  /// null means the owner has not tracked stock; treat the product as available.
  stock       Int?
  /// Public URLs of the product's images in Supabase Storage.
  images      String[] @default([])
  createdAt   DateTime @default(now())

  /// pgvector embedding of name + description + category, used for semantic
  /// search. 1024 dimensions from jina-embeddings-v3. Unsupported by
  /// Prisma Client; read/written with raw SQL in lib/embedding-pipeline.ts.
  embedding Unsupported("vector(1024)")?

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  sales    Sale[]

  @@index([businessId])
}

model Sale {
  id            String   @id @default(cuid())
  businessId    String
  customerId    String
  /// null when the sale is a productless "custom amount" line (Quick Sale).
  productId     String?
  /// Human-readable label for productless lines, e.g. "Delivery charge".
  customLabel   String?
  quantity      Int
  totalAmount   Decimal  @db.Decimal(10, 2)
  status        String
  /// How the sale was paid: "cash" | "transfer" | "pos" | "credit". Null on rows created before this field existed.
  paymentMethod String?
  createdAt     DateTime @default(now())

  business Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer Customer  @relation(fields: [customerId], references: [id])
  product  Product?  @relation(fields: [productId], references: [id])
  invoices Invoice[]

  @@index([businessId])
  @@index([customerId])
  @@index([productId])
}

model Conversation {
  id         String   @id @default(cuid())
  businessId String
  customerId String
  /// AI kill switch: "AI_HANDLING" | "ESCALATED" | "HUMAN_TAKEOVER".
  status     String   @default("AI_HANDLING")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  /// Per-chat instructions from the owner for the AI (for example a discount
  /// they promised this specific customer). Injected into the system prompt.
  aiContext String? @db.Text

  /// Human takeover. null means the AI answers automatically; a future
  /// timestamp means an agent has taken over and the AI stays quiet until then.
  /// An expired timestamp counts as active again, so the AI resumes on its own.
  pausedUntil DateTime?

  /// Live negotiation state (listPrice, floorPrice, currentOffer, round, ...).
  /// null means no negotiation is in progress. Reset when the product in play
  /// changes or after 24 hours of inactivity.
  negotiationState Json?

  /// Set when the AI calls `escalate_to_owner` (customer asked something the
  /// AI cannot answer — waybill, custom quote, product detail beyond the
  /// description). The owner is alerted on their personal Telegram at the same
  /// time; the flag lets the dashboard surface "needs your attention".
  escalatedAt DateTime?

  business Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer Customer  @relation(fields: [customerId], references: [id])
  messages Message[]

  @@index([businessId])
  @@index([customerId])
}

model Message {
  id             String   @id @default(cuid())
  businessId     String
  conversationId String
  /// Who wrote it: "customer", "ai" (Colly) or "agent" (a human on the team).
  /// Stored as text so a new sender kind is not a migration.
  sender         String
  content        String
  createdAt      DateTime @default(now())

  /// Voice note fields. `audioUrl` is the public URL of the audio in Supabase
  /// Storage; `audioDuration` is the clip length in seconds; `transcript` is the
  /// speech-to-text output. For a voice note `content` mirrors `transcript` so
  /// the existing chat UI and history keep working unchanged.
  audioUrl         String?
  audioDuration    Int?
  transcript       String?
  /// Image fields. `imageUrl` is the public URL of the photo in Supabase
  /// Storage; `imageDescription` is the vision model's short description. For an
  /// image message `content` mirrors `imageDescription` so the existing chat UI
  /// and history keep working unchanged.
  imageUrl         String?
  imageDescription String?
  /// "text" | "voice" | "image". Stored as text so a new kind is not a migration.
  messageType      String  @default("text")

  business     Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([conversationId])
}

// ---------------------------------------------------------------------------
// NRS e-invoicing groundwork. Every paid sale gets an Invoice; manual invoices
// (not tied to a sale) can also be created. The NRS fields are populated when
// the invoice is transmitted to the National Revenue Service via an Access
// Point Provider.
// ---------------------------------------------------------------------------

model Invoice {
  id         String  @id @default(cuid())
  businessId String
  /// The sale this invoice was generated from. null for a manual invoice.
  saleId     String?
  customerId String?

  /// Human-readable, unique per business, e.g. "INV-2026-0001".
  invoiceNumber String
  /// "draft" | "sent" | "failed" | "cancelled".
  status        String @default("draft")

  subtotal Decimal @db.Decimal(10, 2)
  vat      Decimal @default(0) @db.Decimal(10, 2)
  total    Decimal @db.Decimal(10, 2)
  /// Line items: `[{ name, quantity, unitPrice, total }]`.
  items    Json

  /// Invoice Reference Number returned by the NRS.
  irn       String?
  /// QR code payload or URL returned by the NRS.
  qrCode    String?
  nrsSentAt DateTime?
  nrsError  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  business Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  sale     Sale?     @relation(fields: [saleId], references: [id], onDelete: SetNull)
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@unique([businessId, invoiceNumber])
  @@index([businessId, status])
}

model Transaction {
  id         String @id @default(cuid())
  businessId String

  /// Paystack transaction reference (unique so a webhook can be processed once).
  reference        String    @unique
  /// Amount actually charged, in Naira (kept as Decimal for exact math).
  amount           Decimal   @db.Decimal(10, 2)
  /// "success" | "failed" | "pending".
  status           String
  /// "subscription" | "credits".
  type             String
  /// For subscription payments: the plan the customer is on. Missing for
  /// standalone credit purchases.
  plan             String?
  planInterval     String?
  /// For credit purchases: how many credits were bought (1 credit = ₦1).
  creditsPurchased Int?
  /// Paystack funding channel, e.g. "card", "bank", "ussd".
  channel          String?
  paidAt           DateTime?
  createdAt        DateTime  @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, status])
  @@index([businessId, createdAt])
}

// ---------------------------------------------------------------------------
// Agent section. Agents are certified people who sell Colly setup services to
// businesses. They have their own auth, dashboard and training, and never see
// business features. Colly does not pay agents or take a cut; the optional
// referral link (Business.referredByAgentId) is the only connection.
// ---------------------------------------------------------------------------

model Agent {
  id             String    @id @default(cuid())
  /// Human-readable agent id, e.g. "AG-0001".
  agentNumber    String    @unique
  supabaseUserId String?   @unique
  email          String    @unique
  fullName       String
  phone          String?
  /// Nigerian state the agent operates in.
  state          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  certifiedAt    DateTime?

  progress           AgentLessonProgress[]
  quizAttempts       AgentQuizAttempt[]
  certificate        AgentCertificate?
  badges             AgentBadge[]
  finalExamAttempts  AgentFinalExamAttempt[]
  /// Timestamp of the first passing Final Certification Exam attempt.
  finalExamPassedAt  DateTime?
  referredBusinesses Business[]
  /// Agent earnings. `commissionBalanceNaira` is the available balance ready to
  /// withdraw (deducted on payout). Bank details are saved so transfers can be
  /// initiated via Paystack; `paystackRecipientCode` is the transfer recipient.
  commissionBalanceNaira Int    @default(0)
  bankAccountName        String?
  bankAccountNumber      String?
  bankCode               String?
  paystackRecipientCode  String?
  payouts                AgentPayout[]
}

model AgentCourse {
  id                    String   @id @default(cuid())
  slug                  String   @unique
  title                 String
  description           String
  order                 Int      @default(0)
  published             Boolean  @default(true)
  /// Only courses flagged here gate certification. Adding a non-certification course does not revoke anyone's certificate.
  isCertificationCourse Boolean  @default(false)
  createdAt             DateTime @default(now())

  lessons   AgentLesson[]
  questions AgentQuizQuestion[]
  attempts  AgentQuizAttempt[]
}

model AgentLesson {
  id           String   @id @default(cuid())
  courseId     String
  slug         String
  title        String
  order        Int      @default(0)
  bodyMarkdown String   @db.Text
  youtubeUrl   String?
  durationMin  Int?
  createdAt    DateTime @default(now())

  course   AgentCourse           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  progress AgentLessonProgress[]

  @@unique([courseId, slug])
}

model AgentLessonProgress {
  id          String   @id @default(cuid())
  agentId     String
  lessonId    String
  completedAt DateTime @default(now())

  agent  Agent       @relation(fields: [agentId], references: [id], onDelete: Cascade)
  lesson AgentLesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([agentId, lessonId])
}

model AgentQuizQuestion {
  id           String  @id @default(cuid())
  courseId     String
  order        Int     @default(0)
  question     String  @db.Text
  /// Answer options, e.g. ["A", "B", "C", "D"].
  options      Json
  correctIndex Int
  /// Optional explanation shown after a wrong answer. Null when not provided.
  explanation  String? @db.Text

  course AgentCourse @relation(fields: [courseId], references: [id], onDelete: Cascade)
}

model AgentQuizAttempt {
  id          String   @id @default(cuid())
  agentId     String
  courseId    String
  /// 0-100.
  score       Int
  passed      Boolean
  /// Array of chosen option indices.
  answers     Json
  attemptedAt DateTime @default(now())

  agent  Agent       @relation(fields: [agentId], references: [id], onDelete: Cascade)
  course AgentCourse @relation(fields: [courseId], references: [id], onDelete: Cascade)
}

model AgentCertificate {
  id            String   @id @default(cuid())
  agentId       String   @unique
  /// Human-readable certificate id, e.g. "CERT-AG-0001-2026".
  certificateId String   @unique
  issuedAt      DateTime @default(now())

  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)
}

/// Awarded when an agent completes every lesson in a course and passes its
/// quiz. Displayed on the agent dashboard and training pages.
model AgentBadge {
  id         String   @id @default(cuid())
  agentId    String
  /// Matches AgentCourse.slug for the four badge-eligible courses.
  courseSlug String
  earnedAt   DateTime @default(now())

  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@unique([agentId, courseSlug])
  @@index([agentId])
}

// Final Certification Exam
model AgentFinalExamQuestion {
  id           String  @id @default(cuid())
  order        Int     @default(0)
  sectionTitle String
  question     String  @db.Text
  options      Json
  correctIndex Int
  explanation  String? @db.Text

  @@index([order])
}

model AgentFinalExamAttempt {
  id          String   @id @default(cuid())
  agentId     String
  score       Int
  passed      Boolean
  answers     Json
  attemptedAt DateTime @default(now())

  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([agentId, attemptedAt])
}

/// Agent payouts. Each successful transfer from the Paystack balance to the
/// agent's bank account is recorded here.
model AgentPayout {
  id          String   @id @default(cuid())
  agentId     String
  amountNaira Int
  /// "pending" | "success" | "failed".
  status      String   @default("pending")
  /// Paystack transfer reference, unique to avoid double-processing.
  reference   String   @unique
  createdAt   DateTime @default(now())

  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([agentId, createdAt])
}



model WhatsappWaitlist {
  id             String   @id @default(uuid())
  businessId     String?
  whatsappNumber String
  createdAt      DateTime @default(now())
}
