{
  "name": "colly",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npx prisma migrate deploy && npx prisma generate && next build",
    "start": "node node_modules/next/dist/bin/next start",
    "db:deploy": "npx prisma migrate deploy",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "seed": "node prisma/seed.cjs",
    "worker:whatsapp": "tsx workers/whatsapp-worker.ts",
    "academy:sync": "node scripts/sync-academy-content.cjs"
  },
  "dependencies": {
    "@hapi/boom": "^10.0.1",
    "@hello-pangea/dnd": "^18.0.1",
    "@lottiefiles/react-lottie-player": "^3.6.0",
    "@prisma/client": "^6.19.3",
    "@react-pdf/renderer": "^4.9.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "@whiskeysockets/baileys": "^6.7.24",
    "canvas-confetti": "^1.9.4",
    "lucide-react": "^1.52.0",
    "next": "^16.4.5",
    "openai": "^7.30.0",
    "papaparse": "^5.7.0",
    "pino": "^10.4.0",
    "qrcode": "^1.5.4",
    "qrcode.react": "^4.2.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.8",
    "tweetnacl": "^1.0.3"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^20",
    "@types/papaparse": "^5.5.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^16.6.1",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "prisma": "^6.19.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "esbuild@0.28.2": true,
    "prisma@6.19.3": true,
    "unrs-resolver@1.12.2": true
  },
  "description": "Colly is a multi-tenant AI assistant for Nigerian small businesses. It answers customer messages on the channels a shop actually uses, from that shop's own catalogue and FAQs, and hands the conversation to a human when it should.",
  "main": "index.js",
  "directories": {
    "doc": "docs",
    "lib": "lib",
    "test": "tests"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/collyapp-byte/Colly.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/collyapp-byte/Colly/issues"
  },
  "homepage": "https://github.com/collyapp-byte/Colly#readme"
}
