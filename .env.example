# Colly environment variables (reference). Copy to .env and fill in real values.

# Postgres via Prisma. DIRECT_URL is used for migrations.
DATABASE_URL=""
DIRECT_URL=""

# DeepSeek (OpenAI-compatible) — the primary provider for AI replies.
DEEPSEEK_API_KEY=""
# Optional override; defaults to https://api.deepseek.com
DEEPSEEK_BASE_URL=""

# Fallback providers (optional). lib/ai.ts walks DeepSeek -> Groq -> OpenRouter.
# With none of the three keys set, a reply falls back to a static message and
# the owner gets an "ai_unavailable" alert.
GROQ_API_KEY=""
GROQ_BASE_URL="" # defaults to https://api.groq.com/openai/v1
OPENROUTER_API_KEY=""
OPENROUTER_BASE_URL="" # defaults to https://openrouter.ai/api/v1

# Supabase Auth.
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="" # accepted alias for the anon key
# Server-only. Lets the Telegram webhook store customer pictures (payment
# receipts) in Supabase Storage with the service role, which bypasses RLS.
# Never expose this key to the browser and never prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=""

# Public base URL (no trailing slash). Used for Paystack callback redirects and
# the Telegram bot webhook. Must be a public HTTPS origin in production;
# Telegram connect refuses localhost.
NEXT_PUBLIC_APP_URL=""

# Colly Admin Bot (Telegram): delivers owner alerts (AI escalations from the
# escalate_to_owner tool) to the owner's personal chat id saved as
# Business.ownerTelegramChatId. This is a DIFFERENT bot from each business's
# own Business.telegramBotToken — create the admin bot once with @BotFather.
COLLY_TELEGRAM_BOT_TOKEN=""

# Optional legacy fallback for system alerts (lib/alerts.ts). Only read when
# COLLY_TELEGRAM_BOT_TOKEN is unset — prefer the admin bot above.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# Discord channel: the app-wide public key verifies inbound webhook signatures
# (Ed25519). Each business pastes its own bot token in Settings; without the
# public key set here every webhook request is rejected as unsigned.
DISCORD_PUBLIC_KEY=""

# Weekly report email (optional, Resend). Without a key the report is still
# rendered in the dashboard and sent over Telegram; the email is skipped.
RESEND_API_KEY=""
RESEND_FROM_EMAIL="" # defaults to "Colly <reports@colly.com.ng>"

# Paystack billing.
PAYSTACK_SECRET_KEY=""

# Paystack plan codes: one per tier (Green/Blue/Black) and billing interval
# (M = monthly, Y = yearly). There is one unified tier set for every channel —
# there is no per-channel split any more. Create each plan in the Paystack
# dashboard and paste its code here; `getPaystackPlanCode()` in
# app/api/billing/checkout/route.ts reads exactly these six names and checkout
# throws "Paystack Plan Code missing for <tier> <interval>" when one is absent.
PAYSTACK_PLAN_GREEN_M=""
PAYSTACK_PLAN_GREEN_Y=""
PAYSTACK_PLAN_BLUE_M=""
PAYSTACK_PLAN_BLUE_Y=""
PAYSTACK_PLAN_BLACK_M=""
PAYSTACK_PLAN_BLACK_Y=""

# Shared secret for server-to-server calls to POST /api/chat that have no
# dashboard session (e.g. a channel gateway forwarding messages). Sent as the
# X-Colly-Internal-Secret header. Requests without it are rejected.
CHAT_INTERNAL_SECRET=""

# Jiji catalogue import (ReefAPI). Leave blank to make the importer return three
# mock products so the Products page can be tested without a real key.
REEF_API_KEY=""

# Product embeddings (semantic search in lib/tools.ts). Optional: without it the
# catalogue falls back to the pg_trgm fuzzy search.
JINA_API_KEY=""

# Bearer secret for GET /api/cron/maintenance (scheduled wallet sweep + weekly
# report). The workflow sends it as `Authorization: Bearer $CRON_SECRET`.
CRON_SECRET=""

# Umami analytics. Optional: without it the tracker script is never rendered,
# the UmamiTracker component is never mounted and trackEvent() is a no-op.
# Pageviews for client-side (App Router) navigation are sent by
# components/analytics/umami-tracker.tsx — see the comment in app/layout.tsx.
NEXT_PUBLIC_UMAMI_WEBSITE_ID=""

# Microsoft Clarity (session recordings, heatmaps). Optional: without it the
# inline snippet is not rendered. The project ID is the value shown in
# Clarity → Settings → Setup.
NEXT_PUBLIC_CLARITY_ID=""
